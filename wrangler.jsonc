{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wending",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STORE",
        "class_name": "AuthStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthStore"]
    }
  ]
}
